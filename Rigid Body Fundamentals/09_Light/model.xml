<mujoco model="light_setup_visual">
    <compiler angle="degree"/>
    
    <visual>
        <quality shadowsize="4096"/>  <!-- Shadow chất lượng cao -->
    </visual>
    
    <asset>
        <!-- Textures giúp thấy rõ shadow và ánh sáng -->
        <texture name="grid" type="2d" builtin="checker" width="512" height="512" 
                 rgb1="0.2 0.2 0.2" rgb2="0.3 0.3 0.3"/>
        <material name="grid_mat" texture="grid" texrepeat="5 5" reflectance="0.1"/>
        
        <!-- Materials với specular khác nhau -->
        <material name="shiny" specular="1" shininess="0.9" rgba="0.8 0.8 0.8 1"/>
        <material name="matte" specular="0.1" shininess="0.1" rgba="0.8 0.8 0.8 1"/>
    </asset>
    
    <worldbody>
        <!-- Ground với texture để thấy rõ shadow -->
        <geom type="plane" size="5 5 0.1" material="grid_mat"/>
        
        <!-- VÙNG 1: Directional light (Sun) -->
        <body name="sun_zone" pos="-2 0 0">
            <geom type="sphere" size="0.3" pos="0 0 0.3" rgba="1 1 1 1" material="shiny"/>
            <geom type="box" size="0.2 0.2 0.5" pos="0 0 0.5" rgba="0.9 0.9 0.9 1"/>
            <geom type="cylinder" size="0.15 0.4" pos="0 0 1.2" rgba="0.8 0.8 0.8 1" material="matte"/>
        </body>
        
        <!-- VÙNG 2: Red point light -->
        <body name="red_zone" pos="0 -2 0">
            <geom type="sphere" size="0.3" pos="0 0 0.3" rgba="1 1 1 1" material="shiny"/>
            <geom type="box" size="0.2 0.2 0.5" pos="0 0 0.5" rgba="0.9 0.9 0.9 1"/>
            <!-- Visual marker cho vị trí đèn -->
            <geom type="sphere" size="0.05" pos="0 0 1" rgba="1 0 0 1" 
                  contype="0" conaffinity="0"/>
        </body>
        
        <!-- VÙNG 3: Blue spotlight -->
        <body name="blue_zone" pos="2 0 0">
            <!-- Vật trong vùng chiếu sáng -->
            <geom type="sphere" size="0.3" pos="0 0 0.3" rgba="1 1 1 1" material="shiny"/>
            <!-- Vật ngoài vùng chiếu sáng -->
            <geom type="box" size="0.15 0.15 0.3" pos="0.8 0 0.3" rgba="0.9 0.9 0.9 1"/>
            <!-- Visual marker cho spotlight -->
            <geom type="sphere" size="0.05" pos="0 0 2" rgba="0 0 1 1" 
                  contype="0" conaffinity="0"/>
            <!-- Cone visualization (optional) -->
            <geom type="cylinder" size="0.02 0.1" pos="0 0 1.9" euler="0 0 0" 
                  rgba="0 0 1 0.3" contype="0" conaffinity="0"/>
        </body>
        
        <!-- Central cylinder để so sánh tất cả ánh sáng -->
        <geom type="cylinder" size="0.5 1" pos="0 0 1" rgba="0.8 0.8 0.8 1" material="shiny"/>
        
        <!-- ===== LIGHTS ===== -->
        
        <!-- Ambient light nhẹ để không quá tối -->
        <light name="ambient" directional="false" pos="0 0 3" 
               diffuse="0.2 0.2 0.2" specular="0 0 0" castshadow="false"/>
        
        <!-- Sun - Directional light với shadow -->
        <light name="sun" directional="true" pos="0 -5 5" dir="0 1 -1" 
               castshadow="true" 
               diffuse="0.8 0.8 0.8" 
               specular="0.3 0.3 0.3"/>
        
        <!-- Red point light - không shadow -->
        <light name="red_bulb" directional="false" pos="0 -2 1" 
               diffuse="1 0 0" 
               specular="0.5 0 0" 
               castshadow="false"
               attenuation="1 0 0"/>  <!-- Constant attenuation -->
        
        <!-- Blue spotlight - có cutoff -->
        <light name="blue_spot" directional="true" pos="2 0 2" dir="-1 0 -1" 
               diffuse="0 0 1" 
               specular="0 0 0.5" 
               cutoff="30"
               castshadow="false"/>
        
        <!-- Camera để xem toàn cảnh -->
        <camera name="overview" pos="0 -6 4" euler="35 0 0"/>
        <camera name="closeup" pos="0 -2 1.5" euler="20 0 0"/>
    </worldbody>
</mujoco>