<mujoco model="quadrotor_hover">
  <compiler angle="degree"/>
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>

  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.75 0.75 0.75"/>
    <global azimuth="135" elevation="-25"/>
  </visual>

  <asset>
    <texture name="ground_texture" type="2d" builtin="checker"
             rgb1="0.85 0.85 0.85" rgb2="0.95 0.95 0.95" width="256" height="256"/>
    <material name="ground_material" texture="ground_texture" texrepeat="8 8"/>
  </asset>

  <worldbody>
    <light name="sun" directional="true" pos="0 0 4" dir="0 0 -1"/>
    <geom name="ground" type="plane" size="3 3 0.1" material="ground_material"/>
    <camera name="tracking_camera" pos="2.2 -2.2 1.8" mode="targetbody" target="quadrotor" fovy="48"/>
    <site name="hover_target" type="sphere" pos="0 0 1" size="0.045"
          rgba="0.15 0.75 0.25 0.45"/>

    <body name="quadrotor" pos="0 0 1">
      <freejoint name="root"/>
      <inertial pos="0 0 0" mass="1.2" diaginertia="0.025 0.025 0.045"/>
      <geom name="body" type="box" size="0.08 0.08 0.035" rgba="0.12 0.28 0.65 1"/>
      <geom name="front_marker" type="box" pos="0.09 0 0" size="0.025 0.045 0.012"
            rgba="0.15 0.85 0.25 1" contype="0" conaffinity="0"/>

      <geom type="capsule" fromto="0 0 0 0.18 0.18 0" size="0.012"
            rgba="0.20 0.20 0.22 1" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 0.18 -0.18 0" size="0.012"
            rgba="0.20 0.20 0.22 1" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 -0.18 -0.18 0" size="0.012"
            rgba="0.20 0.20 0.22 1" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 -0.18 0.18 0" size="0.012"
            rgba="0.20 0.20 0.22 1" contype="0" conaffinity="0"/>

      <geom type="cylinder" pos="0.18 0.18 0.018" size="0.07 0.004"
            rgba="0.85 0.20 0.15 0.55" contype="0" conaffinity="0"/>
      <geom type="cylinder" pos="0.18 -0.18 0.018" size="0.07 0.004"
            rgba="0.85 0.20 0.15 0.55" contype="0" conaffinity="0"/>
      <geom type="cylinder" pos="-0.18 -0.18 0.018" size="0.07 0.004"
            rgba="0.15 0.35 0.85 0.55" contype="0" conaffinity="0"/>
      <geom type="cylinder" pos="-0.18 0.18 0.018" size="0.07 0.004"
            rgba="0.15 0.35 0.85 0.55" contype="0" conaffinity="0"/>

      <site name="rotor_fl" pos="0.18 0.18 0" size="0.012" rgba="1 0.3 0.2 1"/>
      <site name="rotor_fr" pos="0.18 -0.18 0" size="0.012" rgba="1 0.3 0.2 1"/>
      <site name="rotor_rr" pos="-0.18 -0.18 0" size="0.012" rgba="0.2 0.4 1 1"/>
      <site name="rotor_rl" pos="-0.18 0.18 0" size="0.012" rgba="0.2 0.4 1 1"/>
      <site name="imu" pos="0 0 0" size="0.01" rgba="1 1 0 1"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="thrust_fl" site="rotor_fl" gear="0 0 1 0 0 0.02" ctrlrange="0 6"/>
    <motor name="thrust_fr" site="rotor_fr" gear="0 0 1 0 0 -0.02" ctrlrange="0 6"/>
    <motor name="thrust_rr" site="rotor_rr" gear="0 0 1 0 0 0.02" ctrlrange="0 6"/>
    <motor name="thrust_rl" site="rotor_rl" gear="0 0 1 0 0 -0.02" ctrlrange="0 6"/>
  </actuator>

  <sensor>
    <framepos name="position" objtype="xbody" objname="quadrotor"/>
    <framequat name="orientation" objtype="xbody" objname="quadrotor"/>
    <framelinvel name="linear_velocity" objtype="xbody" objname="quadrotor"/>
    <gyro name="angular_velocity" site="imu"/>
    <accelerometer name="specific_force" site="imu"/>
  </sensor>

  <keyframe>
    <key name="hover" qpos="0 0 1 1 0 0 0" ctrl="2.943 2.943 2.943 2.943"/>
  </keyframe>
</mujoco>
