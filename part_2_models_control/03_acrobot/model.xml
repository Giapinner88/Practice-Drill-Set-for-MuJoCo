<mujoco model="acrobot_energy_lqr">
    <option timestep="0.002" integrator="Euler" gravity="0 0 -9.81"/>

    <visual>
        <map znear="0.01" zfar="6"/>
    </visual>

    <worldbody>
        <light pos="0 -3 4" dir="0 1 -1" directional="true" castshadow="true"/>
        <geom name="floor" type="plane" size="3 3 0.1" rgba="0.82 0.88 0.82 1"/>
        <camera name="cam_side" pos="0 -5 2" quat="0.7071 0.7071 0 0"/>

        <body name="shoulder" pos="0 0 2.2">
            <geom name="shoulder_pivot" type="cylinder" size="0.07 0.12"
                  quat="0.7071 0.7071 0 0" rgba="0.15 0.15 0.18 1"/>
            <body name="link_1" pos="0 0 0">
                <joint name="shoulder_hinge" type="hinge" axis="0 1 0"
                       damping="0.02"/>
                <inertial pos="0 0 -0.7" mass="1.0"
                          diaginertia="1e-6 1e-6 1e-6"/>
                <geom name="link_1_visual" type="capsule" fromto="0 0 0 0 0 -0.7"
                      size="0.035" rgba="0.15 0.35 0.85 1"
                      contype="0" conaffinity="0"/>

                <body name="link_2" pos="0 0 -0.7">
                    <joint name="elbow_hinge" type="hinge" axis="0 1 0"
                           damping="0.02"/>
                    <inertial pos="0 0 -0.7" mass="1.0"
                              diaginertia="1e-6 1e-6 1e-6"/>
                    <geom name="elbow_marker" type="sphere" size="0.055"
                          rgba="0.9 0.55 0.1 1"/>
                    <geom name="link_2_visual" type="capsule" fromto="0 0 0 0 0 -0.7"
                          size="0.035" rgba="0.85 0.25 0.2 1"
                          contype="0" conaffinity="0"/>
                    <geom name="tip_mass" type="sphere" pos="0 0 -0.7" size="0.065"
                          rgba="0.2 0.2 0.22 1"/>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <motor name="elbow_torque" joint="elbow_hinge" gear="1"
               ctrllimited="true" ctrlrange="-8 8"/>
    </actuator>

    <sensor>
        <jointpos name="shoulder_position" joint="shoulder_hinge"/>
        <jointpos name="elbow_position" joint="elbow_hinge"/>
        <jointvel name="shoulder_velocity" joint="shoulder_hinge"/>
        <jointvel name="elbow_velocity" joint="elbow_hinge"/>
        <actuatorfrc name="elbow_torque_sensor" actuator="elbow_torque"/>
    </sensor>
</mujoco>
